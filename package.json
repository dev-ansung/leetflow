{
  "name": "leetflow",
  "displayName": "LeetFlow",
  "description": "Intelligent, adaptive LeetCode practice companion with local test runners and spaced repetition.",
  "version": "1.0.2",
  "publisher": "dev-ansung",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "leetcode",
    "algorithm",
    "interview",
    "python",
    "spaced-repetition",
    "coding-interview",
    "blind75",
    "neetcode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leetflow.next",
        "title": "Next Recommended Problem",
        "category": "LeetFlow",
        "icon": "$(play)"
      },
      {
        "command": "leetflow.test",
        "title": "Run Tests",
        "category": "LeetFlow",
        "icon": "$(beaker)"
      },
      {
        "command": "leetflow.submit",
        "title": "Submit Solution",
        "category": "LeetFlow",
        "icon": "$(pass-filled)"
      },
      {
        "command": "leetflow.resetProblem",
        "title": "Reset Current Solution to Starter Code",
        "category": "LeetFlow",
        "icon": "$(discard)"
      },
      {
        "command": "leetflow.modernizeSolution",
        "title": "Modernize Current Solution to Modern Python",
        "category": "LeetFlow",
        "icon": "$(wand)"
      },
      {
        "command": "leetflow.stats",
        "title": "View Stats & Mastery",
        "category": "LeetFlow",
        "icon": "$(graph)"
      },
      {
        "command": "leetflow.openProblem",
        "title": "Open Problem by Number, Name, or URL",
        "category": "LeetFlow",
        "icon": "$(search)"
      },
      {
        "command": "leetflow.console",
        "title": "Open Dashboard",
        "category": "LeetFlow",
        "icon": "$(dashboard)"
      },
      {
        "command": "leetflow.switchTrack",
        "title": "Switch Active Roadmap Track...",
        "category": "LeetFlow",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "leetflow.toggleTimer",
        "title": "Pause / Resume Stopwatch Timer",
        "category": "LeetFlow",
        "icon": "$(debug-pause)"
      },
      {
        "command": "leetflow.selectInterpreter",
        "title": "Select Python Interpreter...",
        "category": "LeetFlow",
        "icon": "$(file-code)"
      },
      {
        "command": "leetflow.resetProgress",
        "title": "Reset All Progress & Telemetry Data",
        "category": "LeetFlow"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetflow-explorer",
          "title": "LeetFlow",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "leetflow-explorer": [
        {
          "id": "leetflow.tracksView",
          "name": "Practice Tracks"
        },
        {
          "id": "leetflow.statsView",
          "name": "Proficiency & Telemetry"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "leetflow.switchTrack",
          "when": "view == leetflow.tracksView",
          "group": "navigation@1"
        },
        {
          "command": "leetflow.openProblem",
          "when": "view == leetflow.tracksView",
          "group": "navigation@2"
        },
        {
          "command": "leetflow.next",
          "when": "view == leetflow.tracksView",
          "group": "navigation@3"
        },
        {
          "command": "leetflow.console",
          "when": "view == leetflow.statsView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "leetflow.test",
          "group": "navigation@1",
          "when": "resourceExtname == .py"
        },
        {
          "command": "leetflow.submit",
          "group": "navigation@2",
          "when": "resourceExtname == .py"
        },
        {
          "command": "leetflow.resetProblem",
          "group": "navigation@3",
          "when": "resourceExtname == .py"
        }
      ]
    },
    "configuration": {
      "title": "LeetFlow",
      "properties": {
        "leetflow.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Python interpreter (e.g. /opt/homebrew/bin/python3.14 or .venv/bin/python)"
        }
      }
    }
  },
  "scripts": {
    "build": "bun run build:bundle",
    "build:bundle": "bun build ./src/extension.ts --outfile=./dist/extension.js --target=node --external=vscode --format=cjs",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies --out artifacts/vsix/leetflow-1.0.0.vsix",
    "test": "bun test",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "author": "dev-ansung (https://github.com/dev-ansung)",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-ansung/leetflow"
  },
  "homepage": "https://github.com/dev-ansung/leetflow#readme",
  "bugs": {
    "url": "https://github.com/dev-ansung/leetflow/issues"
  },
  "qna": "marketplace"
}